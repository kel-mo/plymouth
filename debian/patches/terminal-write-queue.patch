-/* The terminal fd is non-blocking so a read can never stall the event
- * loop (and with it the console redirect that PID 1 writes into).  Output
- * therefore has to cope with EAGAIN: wait for room while the terminal
- * drains, but give up after a second without progress, a wedged console
- * must not stall the daemon either.
+/* Writes what the terminal takes without blocking; other failures drop the queue */
+static bool
+ply_terminal_write_queued_output (ply_terminal_t *terminal)
+{
+        while (ply_buffer_get_size (terminal->output_buffer) > 0) {
+                ssize_t n;
+
+                n = write (terminal->fd,
+                           ply_buffer_get_bytes (terminal->output_buffer),
+                           ply_buffer_get_size (terminal->output_buffer));
+
+                if (n > 0) {
+                        ply_buffer_remove_bytes (terminal->output_buffer, n);
+                        continue;
+                }
+
+                if (n < 0 && errno == EINTR)
+                        continue;
+
+                if (n < 0 && errno == EAGAIN)
+                        return true;
+
+                ply_trace ("could not write to terminal %s: %m", terminal->name);
+                ply_buffer_clear (terminal->output_buffer);
+                return false;
+        }
+
+        return true;
+}
+
+static void
+ply_terminal_stop_writing_queued_output (ply_terminal_t *terminal)
+{
+        if (terminal->output_watch == NULL)
+                return;
+
+        if (terminal->loop != NULL)
+                ply_event_loop_stop_watching_fd (terminal->loop, terminal->output_watch);
+
+        terminal->output_watch = NULL;
+}
+
+static void
+on_tty_can_take_data (ply_terminal_t *terminal)
+{
+        ply_terminal_write_queued_output (terminal);
+
+        if (ply_buffer_get_size (terminal->output_buffer) == 0)
+                ply_terminal_stop_writing_queued_output (terminal);
+}
+
+static void
+ply_terminal_start_writing_queued_output (ply_terminal_t *terminal)
+{
+        if (terminal->output_watch != NULL)
+                return;
+
+        terminal->output_watch = ply_event_loop_watch_fd (terminal->loop, terminal->fd,
+                                                          PLY_EVENT_LOOP_FD_STATUS_CAN_TAKE_DATA,
+                                                          (ply_event_handler_t) on_tty_can_take_data,
+                                                          NULL,
+                                                          terminal);
+}
