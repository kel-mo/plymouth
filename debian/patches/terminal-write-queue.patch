+/* The fd is non-blocking: what the terminal can't take yet is queued and
+ * written as it drains
+ */
+bool
+ply_terminal_write_bytes (ply_terminal_t *terminal,
+                          const char     *bytes,
+                          size_t          size)
+{
+        assert (terminal != NULL);
+
+        if (terminal->fd < 0)
+                return false;
+
+        ply_buffer_append_bytes (terminal->output_buffer, bytes, size);
+
+        /* already waiting for room; keep the order */
+        if (terminal->output_watch != NULL)
+                return true;
+
+        if (!ply_terminal_write_queued_output (terminal))
+                return false;
+
+        if (ply_buffer_get_size (terminal->output_buffer) == 0)
+                return true;
+
+        if (terminal->loop != NULL)
+                ply_terminal_start_writing_queued_output (terminal);
+        else
+                ply_terminal_flush_output (terminal);
+
+        return true;
