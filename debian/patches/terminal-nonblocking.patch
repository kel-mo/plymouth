+/* The terminal fd is non-blocking so a read can never stall the event
+ * loop (and with it the console redirect that PID 1 writes into).  Output
+ * therefore has to cope with EAGAIN: wait for room while the terminal
+ * drains, but give up after a second without progress, a wedged console
+ * must not stall the daemon either.
+ */
+bool
+ply_terminal_write_bytes (ply_terminal_t *terminal,
+                          const char     *bytes,
+                          size_t          size)
+{
+        size_t written = 0;
+        double deadline;
+
+        assert (terminal != NULL);
+
+        if (terminal->fd < 0)
+                return false;
+
+        deadline = ply_get_timestamp () + 1.0;
+
+        while (written < size) {
+                ssize_t n;
+
+                n = write (terminal->fd, bytes + written, size - written);
+
+                if (n > 0) {
+                        written += n;
+                        deadline = ply_get_timestamp () + 1.0;
+                        continue;
+                }
+
+                if (n < 0 && errno == EINTR)
+                        continue;
+
+                if (n < 0 && errno == EAGAIN) {
+                        struct pollfd poll_data;
+                        double remaining;
+
+                        remaining = deadline - ply_get_timestamp ();
+                        if (remaining <= 0)
+                                break;
+
+                        poll_data.fd = terminal->fd;
+                        poll_data.events = POLLOUT;
+                        poll_data.revents = 0;
+                        poll (&poll_data, 1, (int) (remaining * 1000) + 1);
+                        continue;
+                }
+
+                break;
+        }
+
+        return written == size;
+}
+
